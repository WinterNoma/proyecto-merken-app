# Conexión de la API de sincronización a MySQL (Tierra).
# Copia este archivo como server/.env y rellena los valores. server/.env NO se sube a git.
# La app móvil NUNCA usa estas credenciales: solo la API.
# En desarrollo, vite.config.ts lee de aquí las variables MYSQL_* (no tiene valores por defecto).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# REQUIRED si el servidor admite TLS (recomendado fuera de la red local)
MYSQL_SSL_MODE=REQUIRED

# DynamoDB (Tierra). Pide las claves al responsable del backend; nunca las subas ni las metas en el APK.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_RECORDS=health_records
DYNAMODB_TABLE_CHANGES=sync_changes
DYNAMODB_TABLE_HEADS=sync_heads
