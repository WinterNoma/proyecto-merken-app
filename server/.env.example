# Conexión de la API de sincronización a MySQL (Tierra).
# Copia este archivo como server/.env y rellena los valores. server/.env NO se sube a git.
# La app móvil NUNCA usa estas credenciales: solo la API.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# REQUIRED si el servidor admite TLS (recomendado fuera de la red local)
MYSQL_SSL_MODE=REQUIRED
